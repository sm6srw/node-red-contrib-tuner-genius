    {
        "id": "tg-comment-control",
        "type": "comment",
        "z": "tg-tab",
        "name": "Control: click the inject buttons to operate the tuner",
        "info": "The first control node takes its action from msg.topic. For operate and bypass a payload of true, 1 or \"on\" enables and anything else disables. Activate selects antenna 1-3 on 3WAY units, or channel 1-2 on SO2R units.\n\nThe last control node has a fixed action, which always takes precedence over msg.topic.",
        "x": 250,
        "y": 580,
        "wires": []
    },
