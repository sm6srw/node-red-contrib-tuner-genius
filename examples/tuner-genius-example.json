[
    {
        "id": "tg-tab",
        "type": "tab",
        "label": "Tuner Genius",
        "disabled": false,
        "info": "Example flow for node-red-contrib-tuner-genius.\n\nSet the host of the **tuner genius** server node to the address of your Tuner Genius XL, deploy, and watch the debug sidebar."
    },
    {
        "id": "tg-server",
        "type": "tuner-genius-server",
        "host": "192.168.1.100",
        "port": 9010,
        "autoConnect": true,
        "pollInterval": 1000
    },
    {
        "id": "tg-comment-setup",
        "type": "comment",
        "z": "tg-tab",
        "name": "Setup: edit the tuner genius server node (host), then deploy",
        "info": "Double click any Tuner Genius node, then the pencil next to Server, and enter the host name or IP address of the tuner. The API port is 9010.",
        "x": 270,
        "y": 40,
        "wires": []
    },
    {
        "id": "tg-comment-monitor",
        "type": "comment",
        "z": "tg-tab",
        "name": "Monitor: one status node per property",
        "info": "Each status node subscribes to one property and only emits when the value changes. The topic is the property name and msg.previous holds the previous value.\n\nfwd is in dBm and swr is the return loss in dB (-60 when there is no RF). Use the deadband to ignore small changes in noisy values.",
        "x": 210,
        "y": 100,
        "wires": []
    },
    {
        "id": "tg-status-fwd",
        "type": "tuner-genius-status",
        "z": "tg-tab",
        "name": "",
        "server": "tg-server",
        "property": "fwd",
        "onlyChange": true,
        "deadband": 0.5,
        "startDelay": 1000,
        "x": 150,
        "y": 160,
        "wires": [["tg-debug-fwd"]]
    },
    {
        "id": "tg-debug-fwd",
        "type": "debug",
        "z": "tg-tab",
        "name": "fwd (dBm)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 420,
        "y": 160,
        "wires": []
    },
    {
        "id": "tg-status-swr",
        "type": "tuner-genius-status",
